# Set these as GitHub Codespaces secrets with the exact same names: Settings -> Secrets and variables -> Codespaces.
# .devcontainer/generate-env.sh reads the keys below (comments/blank lines are ignored) and regenerates .env from them on every Codespace creation.
# GOOGLE_SERVICE_ACC_PRIVATE_KEY must be a single line with literal \n escapes (see src/shared/google_service_account.ts), not an actual multi-line PEM block.

GOOGLE_SERVICE_ACC_EMAIL=
GOOGLE_SERVICE_ACC_PRIVATE_KEY=
