# Set these as GitHub Codespaces secrets: Settings -> Secrets and variables -> Codespaces.
# .devcontainer/generate-env.sh reads the keys below (comments/blank lines are ignored) and regenerates two files on every Codespace creation:
#   .env             <- DEV_<KEY>  secrets (test/sandbox keys, read by `slack run`)
#   .env.production  <- PROD_<KEY> secrets (prod keys, pushed to the deployed app by `npm run env:sync`)
# A secret named exactly <KEY> (no prefix) is the fallback for both files - use it for values shared by test and prod.
# GOOGLE_SERVICE_ACC_PRIVATE_KEY must be a single line with literal \n escapes (see src/shared/google_service_account.ts), not an actual multi-line PEM block.

GOOGLE_SERVICE_ACC_EMAIL=
GOOGLE_SERVICE_ACC_PRIVATE_KEY=

# DOCUSEAL_API_URL may stay empty - it then defaults to the EU server
# (https://api.docuseal.eu). Only the hosts listed in manifest.ts
# outgoingDomains can be reached.
DOCUSEAL_API_KEY=
DOCUSEAL_API_URL=
